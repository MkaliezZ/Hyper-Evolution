{
  "$defs": {
    "AssetReference": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "task_snapshot",
            "source_text",
            "submission",
            "evaluation",
            "review",
            "attachment",
            "local_submission"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "owner_ref": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Owner Ref",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "asset_id",
        "task_id",
        "kind",
        "record_id",
        "owner_ref",
        "revision",
        "source_hash"
      ],
      "title": "AssetReference",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "whole",
          "enum": [
            "whole",
            "text",
            "page",
            "region",
            "time"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "region": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        }
      },
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "companion.capability.v1",
      "default": "companion.capability.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "needs_input",
        "needs_review",
        "unavailable",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/AssetReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "missing": {
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "decision_trace": {
      "additionalProperties": true,
      "title": "Decision Trace",
      "type": "object"
    },
    "commit_receipt": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Receipt"
    }
  },
  "required": [
    "request_id",
    "operation",
    "status"
  ],
  "title": "CapabilityResult",
  "type": "object"
}
